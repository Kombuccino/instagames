{
  "name": "minifugg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test:audio": "node scripts/test-core-audio.mjs",
    "test:audio:browser": "node scripts/test-audio-browser.mjs",
    "test:layout:browser": "node scripts/test-core-mobile-layout.mjs",
    "vendor:phaser-skills": "node scripts/vendor-phaser-skills.mjs",
    "repo:check": "node scripts/repository-preflight.mjs",
    "test:repository": "node --test scripts/test-repository-preflight.mjs scripts/test-game-definitions.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@vitejs/plugin-react": "^4.3.3",
    "phaser": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.63.0"
  }
}
